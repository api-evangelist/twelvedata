{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twelve Data REST Core Data Fundamentals API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Fundamentals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Company profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twelvedata.com/profile",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query",
                "description": "Instrument symbol, e.g. AAPL, EUR/USD, or BTC/USD."
              },
              {
                "name": "apikey",
                "value": "",
                "type": "query",
                "description": "Your Twelve Data API key."
              }
            ]
          },
          "docs": "Returns the company profile (sector, industry, description, employees, and more)."
        },
        {
