          "name": "Time series (OHLCV)",
          "request": {
            "name": "Time series (OHLCV)",
            "description": {
              "content": "Returns meta and time series (open, high, low, close, volume) for the requested instrument at the requested interval. Core endpoint for historical and intraday market data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "time_series"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "symbol",
                  "value": "<string>",
                  "description": "(Required) Instrument symbol, e.g. AAPL, EUR/USD, or BTC/USD."
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<string>",
                  "description": "(Required) Time interval between two consecutive data points."
                },
                {
                  "disabled": false,
                  "key": "outputsize",
                  "value": "30",
                  "description": "Number of data points to return (max 5000)."
                },
                {
                  "disabled": false,
                  "key": "exchange",
                  "value": "<string>",
                  "description": "Exchange to which the instrument belongs."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "JSON"
                },
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) Your Twelve Data API key."
                }
