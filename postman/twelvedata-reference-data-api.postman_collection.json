{
  "info": {
    "_postman_id": "24cacf41-a7dc-434e-b4ff-55fa5e517188",
    "name": "Twelve Data REST Core Data Reference Data API",
    "description": "REST API for Twelve Data financial market data covering stocks, forex, cryptocurrencies, ETFs, indices, commodities, and funds. Provides historical and real-time time series (OHLCV), quotes and prices, 100+ technical indicators, reference / catalog data, and company fundamentals. All requests are authenticated with an apikey supplied either as a query parameter (?apikey=) or via the `Authorization: apikey <KEY>` header. Every endpoint consumes a data-weight number of API credits; the per-minute credit quota resets each minute.\n\nContact Support:\n Name: Twelve Data Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:21:22.000Z",
    "updatedAt": "2026-07-28T03:21:22.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-24cacf41-a7dc-434e-b4ff-55fa5e517188"
  },
