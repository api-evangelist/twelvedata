        {
          "name": "Relative Strength Index (RSI)",
          "id": "3e5e6ac9-eaaa-47ff-8660-6a8cc336e655",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rsi?symbol=<string>&interval=30min&time_period=14&apikey=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rsi"
              ],
              "query": [
                {
                  "description": "(Required) Instrument symbol, e.g. AAPL, EUR/USD, or BTC/USD.",
                  "key": "symbol",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Time interval between two consecutive data points.",
                  "key": "interval",
                  "value": "30min"
                },
                {
                  "key": "time_period",
                  "value": "14"
                },
                {
                  "description": "(Required) Your Twelve Data API key.",
                  "key": "apikey",
                  "value": "<string>"
                }
              ]
            },
            "description": "Returns the RSI momentum indicator time series. Representative of the 100+ technical indicator endpoints (macd, bbands, ema, sma, adx, stoch, atr, and more) that share the same parameter conventions."
